{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faizamalikfm1411-ux/ZAAD_FYP/shared/rules/safety-rules.schema.json",
  "title": "ZAAD shared safety rules",
  "description": "One rules file used by the Python backend (authoritative) and the TypeScript mirror in the browser. Source: SRS v1.2 Appendix C, Table 4.7, FR-ALG-01 to 11. Owner: Khansa Farooq.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rulesVersion", "contentStatus", "riskLevels", "traceFlags", "allergens", "dietTypes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rulesVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contentStatus": {
      "description": "skeleton = structure only (S1-FM-05). v0 = Appendix C content (S1-KF-04). v1 = Guardian v0/v1 content (S2-KF-08). Anything other than skeleton must have at least one hidden name per allergen.",
      "enum": ["skeleton", "v0", "v1"]
    },
    "riskLevels": {
      "description": "Fixed by FR-ALG-03 and Appendix C Table C.2.",
      "const": ["SAFE", "CAUTION", "DANGER"]
    },
    "traceFlags": {
      "description": "Dish-data flags that produce CAUTION (FR-ALG-05).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/snakeId" }
    },
    "allergens": {
      "description": "Exactly the ten Appendix C categories, one entry each.",
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/allergen" }
    },
    "dietTypes": {
      "description": "SRS Table 4.7. Calorie and diet rules are added in later tasks.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/dietType" }
    }
  },
  "$defs": {
    "snakeId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
    "matchName": {
      "description": "Lowercase ingredient name, trimmed, letters, digits, spaces and hyphens only.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9 -]*[a-z0-9])?$"
    },
    "allergen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameEn", "nameUr", "hiddenNames", "directNames"],
      "properties": {
        "id": {
          "description": "Language-independent, never changes (FR-ALG-11).",
          "enum": ["gluten", "nuts", "dairy", "eggs", "shellfish", "soy", "sesame", "fish", "sulfites", "mustard"]
        },
        "nameEn": { "type": "string", "minLength": 1 },
        "nameUr": { "type": ["string", "null"], "minLength": 1 },
        "hiddenNames": {
          "description": "Hidden or alternate names from Appendix C Table C.1 (FR-ALG-02).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/matchName" }
        },
        "directNames": {
          "description": "Plain ingredient names that unambiguously contain this allergen.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/matchName" }
        }
      }
    },
    "dietType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameEn", "targetGoal"],
      "properties": {
        "id": { "enum": ["weight_loss", "muscle_gain", "maintenance", "diabetic_friendly", "heart_healthy"] },
        "nameEn": { "type": "string", "minLength": 1 },
        "targetGoal": { "type": "string", "minLength": 1 }
      }
    }
  }
}
